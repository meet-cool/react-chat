# 前端环境配置示例（复制为 .env 或 .env.production 使用）
# API 基址：默认已内置生产地址 https://api.met.cc.cd，本地开发可覆盖
VITE_API_BASE_URL=https://api.met.cc.cd

# 调试页密码（S17）：DebugPage 与 SettingsModal 的调试模式入口共用此变量。
# - 本地开发可填任意字符串（如 debug2024）以启用调试入口；
# - 生产构建请保持为空（或删除该行），前端 bundle 中将不包含明文密码，
#   调试入口自动拒绝访问，消除"提示：debug2024"被反编译的泄露面。
VITE_DEBUG_PASSWORD=
